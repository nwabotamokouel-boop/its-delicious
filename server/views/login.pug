extends layout

block content
  .auth-page
    .auth-card.reveal
      .auth-logo IT'S DELICIOUS 🤤
      h2 Welcome Back
      p Sign in to track your orders
      if error
        .auth-error ⚠️ #{error}
      form(action='/login', method='POST')
        .form-group
          label Email
          input(type='email', name='email', placeholder='your@email.com', required)
        .form-group
          label Password
          input(type='password', name='password', placeholder='••••••••', required)
        button.btn-primary(type='submit') Login
      .auth-footer
        p Don't have an account? #[a(href='/register') Register here]
